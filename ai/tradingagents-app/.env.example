# ==== bruinxz/stocks + TradingAgents 合并单仓 · AI 服务共享环境变量 ====
# 本文件是 ai/tradingagents-app 运行所需 env 的样例, 复制为 .env 并填真实值.
# 数据源统一: A 股行情/基本面以 stocks Node 后端 (/api/internal/*) 为唯一真源.

# ---- 内部数据 API (指向同机 stocks 后端) ----
INTERNAL_API_BASE_URL=http://127.0.0.1:3000
INTERNAL_API_KEY=            # 必填, 与 stocks backend/.env 的 INTERNAL_API_KEY 同值

# ---- 共享 Postgres (与 stocks 同库 stock_backtest) ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=           # 必填
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=stock_backtest

# ---- 共享 Redis ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# ---- LLM (火山方舟 / OpenAI 兼容) ----
ARK_API_KEY=                 # 火山方舟 API key；只通过环境文件注入，不再读取 config.json
TRADINGAGENTS_LLM_PROVIDER=volcengine
TRADINGAGENTS_LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
TRADINGAGENTS_DEEP_MODEL=ep-xxxxxxxxxxxxxxxx-xxxxx
TRADINGAGENTS_QUICK_MODEL=ep-xxxxxxxxxxxxxxxx-xxxxx
TRADINGAGENTS_OUTPUT_LANGUAGE=Chinese
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
