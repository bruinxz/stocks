@echo off
echo === 停止A股股票回测系统 ===
echo.

echo 1. 停止前端服务...
taskkill /F /IM node.exe 2>nul | findstr /V "PID"
if %errorlevel% equ 0 (
    echo 前端服务已停止
) else (
    echo 前端服务未运行或无法停止
)

echo.
echo 2. 停止后端服务...
taskkill /F /IM node.exe 2>nul | findstr /V "PID"
if %errorlevel% equ 0 (
    echo 后端服务已停止
) else (
    echo 后端服务未运行或无法停止
)

echo.
echo 3. 检查端口释放情况...
echo 端口3003状态:
netstat -ano | findstr ":3003" > nul
if %errorlevel% equ 0 (
    echo 警告：端口3003仍被占用
    netstat -ano | findstr ":3003"
) else (
    echo 端口3003已释放
)

echo.
echo 端口4001状态:
netstat -ano | findstr ":4001" > nul
if %errorlevel% equ 0 (
    echo 警告：端口4001仍被占用
    netstat -ano | findstr ":4001"
) else (
    echo 端口4001已释放
)

echo.
echo 4. 系统已停止！
echo.
echo 如需重新启动，请运行 start-all.bat
pause