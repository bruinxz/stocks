#!/usr/bin/expect -f
set timeout -1
set password [lindex $argv 0]

spawn ssh -o StrictHostKeyChecking=no -p 14126 root@103.242.3.87 "docker exec stock_postgres psql -U postgres -c \"ALTER ROLE postgres WITH PASSWORD 'K8s#Complex!Password_2026';\""
expect {
    "*yes/no*" { send "yes\r"; exp_continue }
    "*assword:*" { send "$password\r"; exp_continue }
    eof
}
