# ==========================================================
# 实盘 production .env 模板
# - 复制为 backend/.env 后逐项填值，全部填完才能跑 NODE_ENV=production
# - 标 [MUST] 的缺失即拒启；[STRONG] 是强烈推荐；[OPT] 看场景
# - 上线 checklist：docs/live_trading_launch_checklist.md §1.2
# - 灰度真下单阈值：docs/live_trading_launch_checklist.md §1.2 风控段
# ==========================================================

# -------- 基础 --------
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# -------- 鉴权（[MUST]，缺失即拒启）--------
# 必须 ≥32 字符随机；生产环境绝不允许占位符或任何历史泄漏值
JWT_SECRET=
JWT_REFRESH_SECRET=

# -------- 数据库（[MUST]）--------
DB_HOST=
DB_PORT=5432
DB_NAME=stock_backtest
DB_USER=stock_admin
DB_PASSWORD=
DB_SSL=false
# LIVE_TRADING_ALLOW_DB_OFFLINE=true 仅 dev/演示用；production 一律不设，DB 挂掉就拒启
# LIVE_TRADING_ALLOW_DB_OFFLINE=

# -------- Redis（[MUST]）--------
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# -------- CORS（[MUST]，逗号分隔）--------
# 不允许默认 localhost 回退；必须显式列前端域名
ALLOWED_ORIGINS=https://your-frontend-domain.com

# -------- 第一个 admin 账户 bootstrap（[MUST]）--------
# 仅在 production 首次启动且 users 表为空时使用；密码 ≥12 位
LIVE_ADMIN_BOOTSTRAP_PASSWORD=

# -------- 内部 API key（[MUST]，禁止使用任何历史默认值）--------
INTERNAL_API_KEY=

# ==========================================================
# 实盘交易开关（[MUST]，灰度阶段一次开齐）
# ==========================================================
LIVE_TRADING_ENABLED=true
LIVE_ORDER_EXECUTION_ENABLED=true
# 上线前保持 true（熔断状态），切流量瞬间改成 false
LIVE_TRADING_KILL_SWITCH=false

# 网关：bridge_readonly / qmt_bridge / ptrade_bridge
LIVE_BROKER_GATEWAY=qmt_bridge

# 行情源：必须 licensed_configured；否则被持牌闸门拦下
LIVE_MARKET_DATA_PROVIDER=licensed_configured
LIVE_LICENSED_QUOTE_URL_TEMPLATE=https://your-licensed-quote-vendor.com/quote/{symbol}
LIVE_LICENSED_PROVIDER_REQUIRED_FOR_LIVE_ORDER=true

# Shadow autopilot 默认关，灰度阶段不需要
LIVE_SHADOW_AUTOPILOT_ENABLED=false

# ==========================================================
# Bridge 鉴权与协议（[MUST]）
# ==========================================================
# JSON 格式：{"bridge_key": "secret"}；与 bridge 端 config.yaml 严格一致
LIVE_BRIDGE_SECRETS={}
# 不要再用旧的 LIVE_BRIDGE_KEY / LIVE_BRIDGE_SECRET 两个单变量

LIVE_BRIDGE_ENABLED=true
LIVE_BRIDGE_MAX_CLOCK_SKEW_SECONDS=60
LIVE_BRIDGE_NONCE_WINDOW_SECONDS=300
LIVE_BRIDGE_NONCE_CLEANUP_INTERVAL_MS=60000
LIVE_BRIDGE_COMMAND_TTL_SECONDS=60
LIVE_BRIDGE_CANCEL_COMMAND_TTL_SECONDS=180
LIVE_BRIDGE_HEARTBEAT_TIMEOUT_SECONDS=120
LIVE_BRIDGE_EXPIRY_SCAN_INTERVAL_MS=10000
LIVE_BRIDGE_PULL_TICK_MS=2000
LIVE_BRIDGE_BODY_LIMIT=2mb

# ==========================================================
# 风控阈值（[STRONG]，灰度阶段建议值）
# ==========================================================
LIVE_RISK_MAX_SINGLE_ORDER_PCT=0.2
LIVE_RISK_MAX_SINGLE_POSITION_PCT=2
LIVE_RISK_MAX_TOTAL_EXPOSURE_PCT=20
LIVE_RISK_MAX_DAILY_NEW_EXPOSURE_PCT=3
LIVE_RISK_MAX_DAILY_ORDER_COUNT=3
LIVE_RISK_PRICE_DEVIATION_GUARD_PCT=1.0
LIVE_RISK_FAIL_STREAK_KILL=2
LIVE_RISK_DAILY_LOSS_KILL_PCT=1
LIVE_RISK_HEARTBEAT_TIMEOUT_MINUTES=3
LIVE_MARKET_QUOTE_MAX_LATENCY_SECONDS=300
LIVE_MARKET_MAX_MISSING_QUOTE_RATIO_PCT=5
LIVE_MARKET_REQUIRE_QUOTE_BEFORE_ORDER=true
LIVE_MARKET_REQUIRE_REALTIME_FOR_ORDER=true

# kill switch 自动巡检
LIVE_KILL_SWITCH_SCAN_INTERVAL_MS=30000

# 对账过期阈值
LIVE_RECONCILIATION_STALE_MINUTES=120

# ==========================================================
# 任务调度（[OPT]）
# ==========================================================
# 灰度阶段建议先关，避免定时任务干扰
DISABLE_SCHEDULER=true
DISABLE_DEFAULT_TASK_SEED=true

# ==========================================================
# 飞书告警（[STRONG]）
# ==========================================================
# 实盘告警专用群 webhook
FEISHU_RECOMMENDATION_BOT_WEBHOOK=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_MESSAGE_MAX_LENGTH=12000

# 前端跳转链接基地址
FRONTEND_BASE_URL=https://your-frontend-domain.com

# ==========================================================
# 数据/AI 相关（[OPT]，不影响实盘但影响其它接口）
# ==========================================================
TUSHARE_TOKEN=
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
