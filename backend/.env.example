# ===========================================================================
# Backend env template (US-068)
# ---------------------------------------------------------------------------
# 启动前会经 backend/src/config/EnvValidator.ts 校验。production 模式下任何
# 必填项缺失或为占位符会立即 exit；development 模式仅 warn 不阻塞。
# 手动校验：cd backend && npm run check-env
# ===========================================================================

# ---------- 必填: Server ----------
NODE_ENV=development                  # development | production | test
PORT=3000
HOST=0.0.0.0

# ---------- 必填: PostgreSQL ----------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stock_backtest
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false                          # production RDS 通常需要 true

# ---------- 必填: Redis (BullMQ 队列 + redisLock) ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=                       # 留空 = 无密码模式
REDIS_DB=0

# ---------- 必填: JWT ----------
# production 必须 >= 32 字符，强烈建议 64 位随机串
JWT_SECRET=your_jwt_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_EXPIRES_IN=7d
# 仅 development/test 的本地 HTTP 可设 false；production 必须为 true
ENABLE_SECURE_COOKIE=false

# ---------- 必填: TradingAgents (AI 投研 + KOL + 公告 NLP + Copilot) ----------
# Prod 用真实地址（团队私聊给, 不放仓库; 默认 loopback 仅本地开发兜底）
TRADING_AGENTS_URL=http://127.0.0.1:8000

# ---------- 必填（production）: Tab6/7 durable replay ----------
# runtime 目录必须预先创建为当前 Backend OS 用户所有，且 group/world 不可写（建议 0700）。
# DATABASE_URL 只传给 allowlist 后的 replay child；不要把生产口令提交到仓库。
STOCKS_REPLAY_RUNTIME_DIR=/absolute/owner-only/path/to/stocks-replay
# 完整连接串只在本地/部署 secret store 中填写，不提交带凭证的示例值。
DATABASE_URL=
STOCKS_REPLAY_MODEL_VERSION=1.0.0
# 必须替换成已发布模板资产的真实 lowercase SHA-256；下值仅为开发占位符。
STOCKS_REPLAY_TEMPLATE_HASH=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
STOCKS_REPLAY_DISCLAIMERS_JSON={"zh-CN":{"version":"1.0.0","short_text":"仅供研究参考","full_text":"仅供研究参考，不构成投资建议。","language":"zh-CN","effective_at":"2026-01-01T00:00:00Z","hash":"5410d3e9ca5ba3064f28b679bcc32c32ac97d94a2a436bf330b57c3d54432e77"},"ja-JP":{"version":"1.0.0","short_text":"調査目的のみ","full_text":"調査目的のみであり、投資助言ではありません。","language":"ja-JP","effective_at":"2026-01-01T00:00:00Z","hash":"bde57024ab9081069382bfdef7e3d379f834772ca05f44fd5faaa5193fca8fd1"},"ko-KR":{"version":"1.0.0","short_text":"연구 목적 전용","full_text":"연구 목적으로만 제공되며 투자 조언이 아닙니다.","language":"ko-KR","effective_at":"2026-01-01T00:00:00Z","hash":"bea0e686c3467d02057f50456bf6c13f3170f8d18a69d90751ffe0960920c2c2"}}
STOCKS_REPLAY_PYTHON=python3
STOCKS_REPLAY_CLI_TIMEOUT_MS=10000
STOCKS_REPLAY_HTTP_WAIT_MS=1000
STOCKS_REPLAY_CONTROL_TIMEOUT_MS=5000
# production 必须显式配置；lease 必须至少比 worker deadline 多 5 秒。
STOCKS_REPLAY_WORKER_DEADLINE_SECONDS=120
STOCKS_REPLAY_LEASE_SECONDS=150
STOCKS_REPLAY_MAX_CONCURRENCY=2
STOCKS_REPLAY_MAX_QUEUE_DEPTH=32
STOCKS_REPLAY_SUBMIT_RATE_PER_MINUTE=10
STOCKS_REPLAY_STATUS_RATE_PER_MINUTE=120
STOCKS_REPLAY_RATE_MAX_USERS=10000

# ---------- 可选: Feishu (US-063 / US-064 推送) ----------
# 任一字段填了就算"开启此通道"，必须全部填齐（部分填写会失败）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_TABLE_ID=
FEISHU_BITABLE_URL=
FEISHU_MESSAGE_MAX_LENGTH=12000
FEISHU_RECOMMENDATION_BOT_WEBHOOK=
FEISHU_BOT_WEBHOOK=
DISABLE_FEISHU_BOT_WEBHOOK=           # 设为 true 一键禁用

# ---------- 可选: Email SMTP (US-065 周报 / US-067 风控告警) ----------
# 任一字段填了就算"开启此通道"，必须 HOST / USER / PASS 全部填齐
SMTP_HOST=
SMTP_PORT=587                         # STARTTLS 用 587 / SSL 用 465
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false                     # true = SSL (port 465) / false = STARTTLS
SMTP_FROM=                            # 留空走 SMTP_USER
DISABLE_EMAIL_NOTIFICATION=           # 设为 true 一键禁用

# ---------- 可选: WeChat 公众号 (US-066 微信订阅消息) ----------
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_TEMPLATE_DAILY_DIGEST=         # 公众号后台审核通过的模板 ID
WECHAT_TEMPLATE_EARNINGS_FORECAST=
WECHAT_TEMPLATE_RISK_ALERT=
DISABLE_WECHAT_NOTIFICATION=          # 设为 true 一键禁用

# ---------- 可选: Aliyun SMS (US-067 实时风控短信) ----------
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_REGION=cn-hangzhou
ALIYUN_SMS_ENDPOINT=dysmsapi.aliyuncs.com
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_RISK_ALERT=

# ---------- 可选: Tushare 数据源 ----------
TUSHARE_TOKEN=
TUSHARE_PRO_TOKEN=
TUSHARE_ENABLED=false
PYTHON_PATH=python3                   # AKShare helper python 可执行文件

# ---------- 可选: API Rate Limiting ----------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ---------- 可选: Scheduler / runtime 开关 ----------
DISABLE_SCHEDULER=                    # 设为 true 跳过定时任务初始化（测试环境用）
DISABLE_DEFAULT_TASK_SEED=            # 设为 true 跳过默认 cron 任务种子
DISABLE_QUEUE_WORKERS=                # 设为 true 跳过 Bull worker（数据同步 / AI polling / 量化任务）
DISABLE_LIVE_TRADING_BACKGROUND=      # 设为 true 跳过实盘 kill switch / bridge expiry 后台扫描
FRONTEND_BASE_URL=                    # 用于飞书 / 邮件中的 deeplink

# ---------- 可选: 本地开发跳过启动开销 ----------
# 这些主要给 scripts/development/local-dev.sh 连接测试库时使用。
# production 下 SKIP_LEGACY_SCHEMA_REPAIR / SKIP_RECOMMENDATION_RUNTIME_SYNC 会被忽略，关键 schema 兜底仍会执行。
SKIP_DB_SYNC=                         # development 设为 true 跳过 sequelize.sync({ alter: true })
SKIP_LEGACY_SCHEMA_REPAIR=            # 非 production 设为 true 跳过 legacy schema repair
SKIP_RECOMMENDATION_RUNTIME_SYNC=     # 非 production 设为 true 跳过推荐运行时表幂等同步
SKIP_DEFAULT_USER_INIT=               # 设为 true 跳过默认 admin 用户 bootstrap

# ---------- 测试: 仅 dev/test 环境 ----------
ALLOW_WECHAT_BIND_SIMULATE=           # 设为 true 允许 /api/wechat/bind/simulate dev endpoint
