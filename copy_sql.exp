#!/usr/bin/expect -f
set timeout -1
set password [lindex $argv 0]

spawn scp -o StrictHostKeyChecking=no -P 14126 rename_columns.sql root@103.242.3.87:/opt/stocks/rename_columns.sql
expect {
    "*yes/no*" { send "yes\r"; exp_continue }
    "*assword:*" { send "$password\r"; exp_continue }
    eof
}
